# Másold `.env` néven és töltsd ki az értékeket.

# --- Adatbázis ---
# Vercel + Neon: a pooled connection stringet használd DATABASE_URL-ként,
# a direct (nem pooled) stringet DIRECT_URL-ként a migrációkhoz.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# --- Auth.js ---
# openssl rand -base64 32
AUTH_SECRET=""
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# Engedélyezett redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- E-mail (Resend) ---
# Üresen hagyva a levelek nem mennek ki, csak a konzolra íródnak.
RESEND_API_KEY=""
EMAIL_FROM="Időpontfoglaló <noreply@example.com>"

# --- Cron (a Vercel Cron hívás védelme) ---
# openssl rand -hex 32
CRON_SECRET=""

# --- Alkalmazás ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Cron ---
# Milyen sűrűn fut a cron (óra). Vercel Hobby: naponta egyszer => 24.
CRON_INTERVAL_HOURS="24"
